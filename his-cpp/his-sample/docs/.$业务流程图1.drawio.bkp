        </mxCell>
        <mxCell id="q3" parent="lane-front" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#fff;fontSize=11;" value="用户填写查询条件 + 点击【查询】&lt;br&gt;（日期范围必填，其他条件可选）" vertex="1">
