        </mxCell>
        <mxCell id="p1" parent="lane-front" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9b59b6;strokeColor=#7d3c98;fontColor=#fff;fontSize=10;align=left;" value="触发打印&lt;br&gt;├─ 业务发生时自动触发（如挂号→打印挂号小票）&lt;br&gt;├─ 查询列表页点击【打印】按钮&lt;br&gt;└─ 查询列表页点击【补打】按钮" vertex="1">
          <mxGeometry height="100" width="320" x="60" y="40" as="geometry" />
        </mxCell>
